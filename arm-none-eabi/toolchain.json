{
  "name": "arm-gnu-toolchain-15.3.rel1-x86_64-arm-none-eabi",
  "display_name": "ARM GNU Toolchain 15.3.rel1 (arm-none-eabi)",
  "host": "x86_64-linux-gnu",
  "prefix": "arm-none-eabi",
  "target_os": "none",
  "tools": {
    "cc": "arm-none-eabi-gcc",
    "cxx": "arm-none-eabi-g++",
    "ar": "arm-none-eabi-ar",
    "ld": "arm-none-eabi-gcc",
    "strip": "arm-none-eabi-strip",
    "ranlib": "arm-none-eabi-ranlib",
    "objcopy": "arm-none-eabi-objcopy",
    "size": "arm-none-eabi-size",
    "objdump": "arm-none-eabi-objdump",
    "nm": "arm-none-eabi-nm"
  },
  "default_flags": {
    "cflags": [
      "-mcpu=cortex-m4",
      "-mthumb",
      "-Os",
      "-ffunction-sections",
      "-fdata-sections"
    ],
    "cxxflags": [
      "-mcpu=cortex-m4",
      "-mthumb",
      "-Os",
      "-ffunction-sections",
      "-fdata-sections"
    ],
    "ldflags": [
      "-mcpu=cortex-m4",
      "-mthumb",
      "--specs=nosys.specs",
      "-Wl,--gc-sections"
    ]
  },
  "install": {
    "method": "lfs",
    "file": "arm-gnu-toolchain-15.3.rel1-x86_64-arm-none-eabi.tar.xz",
    "format": "tar.xz"
  }
}
